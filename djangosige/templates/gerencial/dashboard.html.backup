{% extends 'base/base.html' %}

{% block title %}Controle Gerencial{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="page-title">💼 Controle Gerencial</h1>
    <p class="page-subtitle">Gestão de pagamentos a fornecedores</p>
</div>

<!-- Dashboard Cards -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 40px;">
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Pagamento Médio Semanal</span>
            <div class="stat-icon">📅</div>
        </div>
        <div class="stat-value">R$ {{ media_semanal|default:"0,00" }}</div>
        <div class="stat-description">Média dos últimos 30 dias</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Pagamento Médio Mensal</span>
            <div class="stat-icon">📊</div>
        </div>
        <div class="stat-value">R$ {{ media_mensal|default:"0,00" }}</div>
        <div class="stat-description">Últimos 12 meses</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Maior Dívida</span>
            <div class="stat-icon">⬆️</div>
        </div>
        <div class="stat-value">R$ {{ maior_divida_valor|default:"0,00" }}</div>
        <div class="stat-description">
            {{ maior_divida_fornecedor|default:"N/A" }}<br>
            <span style="color: #FF9100; font-weight: 700;">{{ maior_divida_percentual|default:"0" }}%</span> do total
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Menor Dívida</span>
            <div class="stat-icon">⬇️</div>
        </div>
        <div class="stat-value">R$ {{ menor_divida_valor|default:"0,00" }}</div>
        <div class="stat-description">
            {{ menor_divida_fornecedor|default:"N/A" }}<br>
            <span style="color: #FF9100; font-weight: 700;">{{ menor_divida_percentual|default:"0" }}%</span> do total
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Total a Pagar</span>
            <div class="stat-icon">💰</div>
        </div>
        <div class="stat-value">R$ {{ total_pagar|default:"0,00" }}</div>
        <div class="stat-description">{{ qtd_fornecedores|default:"0" }} fornecedores</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-label">Vencidos</span>
            <div class="stat-icon">⚠️</div>
        </div>
        <div class="stat-value" style="color: #dc2626;">{{ qtd_vencidos|default:"0" }}</div>
        <div class="stat-description">R$ {{ valor_vencidos|default:"0,00" }}</div>
    </div>
</div>

<!-- Gráficos -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; margin-bottom: 40px;">
    <!-- Gráfico de Pizza -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Distribuição por Fornecedor</h2>
        </div>
        <div class="section-body">
            <canvas id="graficoDistribuicao" style="max-height: 300px;"></canvas>
        </div>
    </div>
    
    <!-- Gráfico de Barras -->
    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Vencimentos Próximos (30 dias)</h2>
        </div>
        <div class="section-body">
            <canvas id="graficoVencimentos" style="max-height: 300px;"></canvas>
        </div>
    </div>
</div>

<!-- Filtros e Ações -->
<div class="section">
    <div class="section-header">
        <h2 class="section-title">Pagamentos a Fornecedores</h2>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="{% url 'gerencial:pagamento_add' %}" class="btn btn-primary">
                ➕ Novo Pagamento
            </a>
            <button type="button" onclick="document.getElementById('formImportar').style.display='block'" class="btn btn-secondary">
                📤 Importar Planilha
            </button>
            <a href="/static/modelo_importacao_pagamentos.csv" download class="btn btn-outline" style="border: 1px solid #e5e7eb; background: white;">
                ⬇️ Baixar Modelo CSV
            </a>
        </div>
    </div>
    
    <!-- Formulário de Importação (oculto por padrão) -->
    <div id="formImportar" style="display: none; margin: 20px 0; padding: 25px; background: #FFF3E0; border-left: 4px solid #FF9100; border-radius: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; color: #0f172a; font-size: 18px; font-weight: 700;">
                📤 Importar Planilha de Pagamentos
            </h3>
            <button onclick="document.getElementById('formImportar').style.display='none'" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #64748b;">
                ✕
            </button>
        </div>
        
        <p style="color: #64748b; margin-bottom: 15px; font-size: 14px;">
            Formatos aceitos: <strong>.csv, .xlsx, .xls</strong><br>
            <a href="/IMPORTACAO_PLANILHAS.md" target="_blank" style="color: #FF9100; text-decoration: underline;">
                📋 Ver instruções e formato esperado
            </a>
        </p>
        
        <form method="post" action="{% url 'gerencial:importar_planilha' %}" enctype="multipart/form-data" style="display: flex; gap: 15px; align-items: end; flex-wrap: wrap;">
            {% csrf_token %}
            <div style="flex: 1; min-width: 300px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #0f172a; margin-bottom: 8px;">
                    Selecione o arquivo:
                </label>
                <input type="file" name="arquivo" accept=".csv,.xlsx,.xls" required 
                       style="width: 100%; padding: 10px; border: 2px dashed #FF9100; border-radius: 6px; background: white; cursor: pointer;">
            </div>
            <button type="submit" class="btn btn-primary" style="white-space: nowrap;">
                🚀 Importar Agora
            </button>
        </form>
        
        <div style="margin-top: 15px; padding: 12px; background: white; border-radius: 6px; font-size: 13px; color: #64748b;">
            <strong style="color: #FF9100;">💡 Dica:</strong> Certifique-se de que os fornecedores já estão cadastrados no sistema antes de importar.
        </div>
    </div>
    
    <!-- Filtros -->
    <div class="section-body">
        <form method="get" style="display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 200px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #64748b; margin-bottom: 6px;">
                    Fornecedor
                </label>
                <select name="fornecedor" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px;">
                    <option value="">Todos</option>
                    {% for f in fornecedores %}
                    <option value="{{ f.id }}" {% if request.GET.fornecedor == f.id|stringformat:"s" %}selected{% endif %}>
                        {{ f.nome_razao_social }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div style="flex: 1; min-width: 150px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #64748b; margin-bottom: 6px;">
                    Status
                </label>
                <select name="status" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px;">
                    <option value="">Todos</option>
                    <option value="pendente" {% if request.GET.status == "pendente" %}selected{% endif %}>Pendente</option>
                    <option value="pago" {% if request.GET.status == "pago" %}selected{% endif %}>Pago</option>
                    <option value="vencido" {% if request.GET.status == "vencido" %}selected{% endif %}>Vencido</option>
                </select>
            </div>
            
            <div style="flex: 1; min-width: 150px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #64748b; margin-bottom: 6px;">
                    Período
                </label>
                <select name="periodo" style="width: 100%; padding: 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px;">
                    <option value="">Todo período</option>
                    <option value="7" {% if request.GET.periodo == "7" %}selected{% endif %}>Últimos 7 dias</option>
                    <option value="30" {% if request.GET.periodo == "30" %}selected{% endif %}>Últimos 30 dias</option>
                    <option value="90" {% if request.GET.periodo == "90" %}selected{% endif %}>Últimos 90 dias</option>
                </select>
            </div>
            
            <div style="display: flex; align-items: flex-end;">
                <button type="submit" class="btn btn-primary" style="height: 44px;">
                    🔍 Filtrar
                </button>
            </div>
        </form>
        
        <!-- Tabela de Pagamentos -->
        <div style="overflow-x: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Fornecedor</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Vencimento</th>
                        <th>Status</th>
                        <th>Dias p/ Venc.</th>
                        <th>% Total</th>
                        <th style="text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for pag in pagamentos %}
                    <tr>
                        <td><strong>{{ pag.fornecedor.nome_razao_social }}</strong></td>
                        <td>{{ pag.descricao|truncatewords:5 }}</td>
                        <td style="font-family: 'Courier New', monospace; font-weight: 600;">
                            R$ {{ pag.valor|floatformat:2 }}
                        </td>
                        <td>{{ pag.data_vencimento|date:"d/m/Y" }}</td>
                        <td>
                            {% if pag.status == 'pago' %}
                            <span class="badge badge-success">✓ Pago</span>
                            {% elif pag.status == 'vencido' %}
                            <span class="badge badge-danger">⚠ Vencido</span>
                            {% else %}
                            <span class="badge badge-warning">⏱ Pendente</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if pag.dias_vencimento < 0 %}
                            <span style="color: #dc2626; font-weight: 700;">{{ pag.dias_vencimento }} dias</span>
                            {% elif pag.dias_vencimento <= 7 %}
                            <span style="color: #f59e0b; font-weight: 700;">{{ pag.dias_vencimento }} dias</span>
                            {% else %}
                            <span style="color: #10b981;">{{ pag.dias_vencimento }} dias</span>
                            {% endif %}
                        </td>
                        <td style="color: #FF9100; font-weight: 700;">{{ pag.percentual_total|floatformat:1 }}%</td>
                        <td style="text-align: center;">
                            <a href="{% url 'gerencial:pagamento_edit' pag.id %}" class="btn-icon" title="Editar">✏️</a>
                            <a href="{% url 'gerencial:pagamento_pagar' pag.id %}" class="btn-icon" title="Marcar como Pago">✓</a>
                            <a href="{% url 'gerencial:pagamento_delete' pag.id %}" class="btn-icon" title="Excluir" onclick="return confirm('Confirma exclusão?')">🗑️</a>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="8" class="empty-state">
                            <div class="empty-state-icon">📋</div>
                            <div class="empty-state-text">Nenhum pagamento cadastrado</div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Scripts para gráficos -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Gráfico de Distribuição (Pizza)
const ctxDist = document.getElementById('graficoDistribuicao').getContext('2d');
new Chart(ctxDist, {
    type: 'doughnut',
    data: {
        labels: {{ grafico_labels|safe }},
        datasets: [{
            data: {{ grafico_valores|safe }},
            backgroundColor: [
                '#FF9100', '#FFB84D', '#E67E00', '#FFA726', '#FB8C00',
                '#F57C00', '#EF6C00', '#E65100', '#FFCC80', '#FFE0B2'
            ],
            borderWidth: 2,
            borderColor: '#ffffff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'bottom' },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        return context.label + ': R$ ' + context.parsed.toFixed(2);
                    }
                }
            }
        }
    }
});

// Gráfico de Vencimentos (Barras)
const ctxVenc = document.getElementById('graficoVencimentos').getContext('2d');
new Chart(ctxVenc, {
    type: 'bar',
    data: {
        labels: {{ vencimentos_labels|safe }},
        datasets: [{
            label: 'Valor (R$)',
            data: {{ vencimentos_valores|safe }},
            backgroundColor: '#FF9100',
            borderColor: '#E67E00',
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: { beginAtZero: true }
        },
        plugins: {
            legend: { display: false }
        }
    }
});
</script>

<style>
.btn-icon {
    display: inline-block;
    padding: 6px 10px;
    font-size: 16px;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s ease;
}
.btn-icon:hover {
    background: #FFF3E0;
    transform: scale(1.1);
}
</style>
{% endblock %}
